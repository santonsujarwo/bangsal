---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reservedSlugs = new Set(['about', 'contact', 'blog', 'services', 'admin', '404']);
  const pages = await getCollection('pages', ({ id }) => !reservedSlugs.has(id));
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<BaseLayout
  title={page.data.seo_title ?? page.data.title}
  description={page.data.seo_description ?? page.data.description}
  canonicalUrl={page.data.canonical_url}
  ogImage={page.data.og_image}
  noindex={page.data.noindex}
  template={page.data.template}
>
  <main>
    <PageSections sections={page.data.sections} />
    <article class="page-body"><Content /></article>
  </main>
</BaseLayout>
