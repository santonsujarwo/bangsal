---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reservedSlugs = new Set(['about', 'contact', 'blog', 'services', 'admin', '404']);
  const pages = await getCollection('pages', ({ id }) => !reservedSlugs.has(id));
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const seo = page.data.seo;
const sections = page.data.sections ?? [];
---
<BaseLayout
  title={seo?.title ?? page.data.seo_title ?? page.data.title}
  description={seo?.description ?? page.data.seo_description ?? page.data.description}
  canonicalUrl={seo?.canonical_url ?? page.data.canonical_url}
  ogImage={seo?.og_image ?? page.data.og_image}
  noindex={seo?.noindex ?? page.data.noindex}
  template={page.data.template}
>
  <main>
    {page.data.content_mode === 'classic'
      ? <article class="page-body"><Content /></article>
      : sections.length > 0
        ? <PageSections sections={sections} />
        : <section class="content-section"><div class="section-inner"><h1>{page.data.title}</h1>{page.data.description && <p>{page.data.description}</p>}</div></section>}
  </main>
</BaseLayout>
