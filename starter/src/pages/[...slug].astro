---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getCollection, render } from 'astro:content';

const reservedSlugs = new Set(['home', 'about', 'contact', 'blog', 'services', 'admin', '404']);

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data, id }) => !data.draft && !reservedSlugs.has(id));
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<BaseLayout title={page.data.seo_title ?? page.data.title} description={page.data.seo_description ?? page.data.description} noindex={page.data.noindex}>
  <main>
    <PageSections sections={page.data.sections} />
    <article class="page-body"><Content /></article>
  </main>
</BaseLayout>
