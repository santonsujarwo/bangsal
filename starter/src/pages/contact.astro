---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'contact');
if (!entry) return Astro.redirect('/404/');
const { Content } = await render(entry);
const seo = entry.data.seo;
const sections = entry.data.sections ?? [];
---
<BaseLayout
  title={seo?.title ?? entry.data.seo_title ?? entry.data.title}
  description={seo?.description ?? entry.data.seo_description ?? entry.data.description ?? 'Contact our team.'}
  canonicalUrl={seo?.canonical_url ?? entry.data.canonical_url}
  ogImage={seo?.og_image ?? entry.data.og_image}
  noindex={seo?.noindex ?? entry.data.noindex}
  template={entry.data.template}
>
  <main>
    {entry.data.content_mode === 'classic'
      ? <article class="page-body"><Content /></article>
      : sections.length > 0
        ? <PageSections sections={sections} />
        : <section class="content-section"><div class="section-inner"><h1>{entry.data.title}</h1>{entry.data.description && <p>{entry.data.description}</p>}</div></section>}
  </main>
</BaseLayout>
