---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('posts', ({ data }) => !data.draft);
---
<BaseLayout title="Blog" description="News and insights.">
  <main>
    <h1>Blog</h1>
    <ul>
      {posts.map((post) => <li><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></li>)}
    </ul>
  </main>
</BaseLayout>
