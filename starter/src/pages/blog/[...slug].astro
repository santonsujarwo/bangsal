---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.seo_title ?? post.data.title} description={post.data.seo_description ?? post.data.excerpt}>
  <article>
    <a href="/blog/">Blog</a>
    <h1>{post.data.title}</h1>
    {post.data.published_at && <time datetime={post.data.published_at.toISOString()}>{post.data.published_at.toLocaleDateString()}</time>}
    <Content />
  </article>
</BaseLayout>
