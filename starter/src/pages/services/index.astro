---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import site from '../../data/site.json';

const services = await getCollection('services', ({ data }) => !data.draft);
const sortedServices = services.sort((a, b) => a.data.sort_order - b.data.sort_order);
const pageTitle = site.services_title || 'Services';
const pageDescription = site.services_description || 'Explore our services.';
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <header class="listing-header">
      <h1>{pageTitle}</h1>
      {pageDescription && <p>{pageDescription}</p>}
    </header>
    <div class="content-card-grid">
      {sortedServices.map((service) => (
        <article class="content-card">
          <a class="content-card-link" href={`/services/${service.id}/`}>
            {service.data.featured_image && <img src={service.data.featured_image} alt={service.data.featured_image_alt ?? ''} loading="lazy" decoding="async" />}
            <div class="content-card-copy">
              <h2>{service.data.title}</h2>
              <p>{service.data.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
