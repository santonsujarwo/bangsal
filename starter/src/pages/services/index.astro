---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const services = await getCollection('services', ({ data }) => !data.draft);
---
<BaseLayout title="Services" description="Explore our services.">
  <main>
    <h1>Services</h1>
    <ul>
      {services.map((service) => <li><a href={`/services/${service.id.replace(/\.md$/, '')}/`}>{service.data.title}</a></li>)}
    </ul>
  </main>
</BaseLayout>
