---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getEntry, render } from 'astro:content';

const home = await getEntry('pages', 'home');
const Content = home ? (await render(home)).Content : null;
const seo = home?.data.seo;
const contentMode = home?.data.content_mode ?? 'blocks';
---
<BaseLayout
  title={seo?.title ?? home?.data.seo_title ?? home?.data.title ?? 'Company Name'}
  description={seo?.description ?? home?.data.seo_description ?? home?.data.description}
  canonicalUrl={seo?.canonical_url ?? home?.data.canonical_url}
  ogImage={seo?.og_image ?? home?.data.og_image}
  noindex={seo?.noindex ?? home?.data.noindex}
  template={home?.data.template}
>
  <main>
    {home ? (
      contentMode === 'blocks' ? (
        <PageSections sections={home.data.sections} />
      ) : (
        <article class="page-body">{Content && <Content />}</article>
      )
    ) : (
      <section class="content-section">
        <div class="section-inner">
          <h1>Homepage content is missing</h1>
          <p>Create the Home page entry in the CMS to display this page.</p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
