---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';
const homeEntry = await getEntry('pages', 'home');
const home = homeEntry && !homeEntry.data.draft ? homeEntry : undefined;
const seo = home?.data.seo;
const editor = home?.data.content_mode;
const mode = typeof editor === 'string' ? editor : (editor?.type ?? 'block_builder');
const sections = editor?.sections ?? home?.data.sections ?? [];
---
<BaseLayout title={seo?.title ?? home?.data.seo_title ?? home?.data.title ?? 'Company Name'} description={seo?.description ?? home?.data.seo_description ?? home?.data.description} canonicalUrl={seo?.canonical_url ?? home?.data.canonical_url} ogImage={seo?.og_image ?? home?.data.og_image} noindex={seo?.noindex ?? home?.data.noindex} template={home?.data.template}>
<main>{home ? (mode === 'classic' ? <article class="page-body" set:html={marked.parse(editor?.body ?? '')} /> : <PageSections sections={sections} />) : <section class="content-section"><div class="section-inner"><h1>Homepage content is missing</h1><p>Create the Home page entry in the CMS to display this page.</p></div></section>}</main>
</BaseLayout>
