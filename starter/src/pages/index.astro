---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getEntry } from 'astro:content';

const home = await getEntry('pages', 'home');
---
<BaseLayout
  title={home?.data.seo_title ?? home?.data.title ?? 'Company Name'}
  description={home?.data.seo_description ?? home?.data.description}
  canonicalUrl={home?.data.canonical_url}
  ogImage={home?.data.og_image}
  noindex={home?.data.noindex}
>
  <main>
    {home ? <PageSections sections={home.data.sections} /> : <section><h1>Welcome</h1><p>Create a home page entry in the CMS.</p></section>}
  </main>
</BaseLayout>
