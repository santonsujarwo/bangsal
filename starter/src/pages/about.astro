---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'about');
if (!entry) return Astro.redirect('/404/');
const { Content } = await render(entry);
---
<BaseLayout
  title={entry.data.seo_title ?? entry.data.title}
  description={entry.data.seo_description ?? entry.data.description}
  canonicalUrl={entry.data.canonical_url}
  ogImage={entry.data.og_image}
  noindex={entry.data.noindex}
  template={entry.data.template}
>
  <main>
    <PageSections sections={entry.data.sections} />
    <article class="page-body"><Content /></article>
  </main>
</BaseLayout>
