---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing pages/about content entry');
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.seo_title ?? entry.data.title} description={entry.data.seo_description ?? entry.data.description} noindex={entry.data.noindex}>
  <main><a href="/">Home</a><h1>{entry.data.title}</h1><Content /></main>
</BaseLayout>
