---
import site from '../data/site.json';
import navigation from '../data/navigation.json';

type SocialLink = { label: string; url: string };
type NavigationItem = { label: string; url: string; external?: boolean };
const socialLinks = (site.social_links ?? []) as SocialLink[];
const navItems = navigation.items as NavigationItem[];
const normalizeUrl = (value: string) => /^https?:\/\//i.test(value) ? value : `https://${value.replace(/^\/+/, '')}`;
const footerNote = (site.footer_note || '').replace('{year}', String(new Date().getFullYear())).replace('Company Name', site.site_name);
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <a class="site-footer-logo" href="/" aria-label={`${site.site_name} home`}>
          {site.logo ? <img src={site.logo} alt={site.site_name} loading="lazy" /> : <span>{site.site_name}</span>}
        </a>
        {site.tagline && <p>{site.tagline}</p>}
        {socialLinks.length > 0 && (
          <nav class="site-footer-social" aria-label="Social media">
            {socialLinks.filter((item) => item.label && item.url).map((item) => (
              <a href={normalizeUrl(item.url)} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
                <span aria-hidden="true">{item.label.trim().charAt(0).toUpperCase()}</span>
              </a>
            ))}
          </nav>
        )}
      </div>
      <div>
        <h2 class="site-footer-heading">Explore</h2>
        <nav class="site-footer-links" aria-label="Footer navigation">
          {navItems.filter((item) => !item.external).map((item) => <a href={item.url}>{item.label}</a>)}
        </nav>
      </div>
      <div>
        <h2 class="site-footer-heading">Get in touch</h2>
        <div class="site-footer-contact">
          {site.phone && <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>}
          {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          {site.address && <span>{site.address}</span>}
        </div>
      </div>
    </div>
    <div class="site-footer-bottom">
      <p>{footerNote}</p>
      <p>Designed for clear communication and better business experiences.</p>
    </div>
  </div>
</footer>
