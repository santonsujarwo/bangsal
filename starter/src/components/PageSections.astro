---
interface SectionItem {
  title: string;
  body?: string;
}
interface Section {
  type: 'hero' | 'rich_text' | 'image_text' | 'feature_grid' | 'cta' | 'faq';
  eyebrow?: string;
  heading?: string;
  body?: string;
  image?: string;
  image_alt?: string;
  button_label?: string;
  button_url?: string;
  items?: SectionItem[];
}
interface Props { sections?: Section[] }
const { sections = [] } = Astro.props;
const isSafeHref = (url?: string) => !!url && ((url.startsWith('/') && !url.startsWith('//')) || url.startsWith('#') || /^https?:\/\//i.test(url) || /^(mailto|tel):/i.test(url));
---
{sections.map((section, index) => (
  <section class:list={['content-section', `section-${section.type}`, section.type === 'hero' && section.image ? 'section-has-image' : '']} aria-labelledby={section.heading ? `section-heading-${index}` : undefined}>
    {section.type === 'hero' && (
      <div class="section-inner hero-layout">
        <div class="hero-copy">
          {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
          {section.heading && <h1 id={`section-heading-${index}`}>{section.heading}</h1>}
          {section.body && <p>{section.body}</p>}
          {section.button_label && isSafeHref(section.button_url) && <a class="button" href={section.button_url}>{section.button_label} <span aria-hidden="true">↗</span></a>}
        </div>
        {section.image && (
          <figure class="hero-media">
            <img src={section.image} alt={section.image_alt ?? ''} loading="eager" fetchpriority="high" decoding="async" />
          </figure>
        )}
      </div>
    )}
    {section.type === 'rich_text' && (
      <div class="section-inner prose">
        {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
        {section.heading && <h2 id={`section-heading-${index}`}>{section.heading}</h2>}
        {section.body && <p>{section.body}</p>}
      </div>
    )}
    {section.type === 'image_text' && (
      <div class:list={["section-inner", "image-text", !section.image && "image-text-no-image"]}>
        {section.image && <img src={section.image} alt={section.image_alt ?? ''} loading="lazy" decoding="async" />}
        <div>
          {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
          {section.heading && <h2 id={`section-heading-${index}`}>{section.heading}</h2>}
          {section.body && <p>{section.body}</p>}
          {section.button_label && isSafeHref(section.button_url) && <a class="button" href={section.button_url}>{section.button_label} <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    )}
    {section.type === 'feature_grid' && (
      <div class="section-inner">
        {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
        {section.heading && <h2 id={`section-heading-${index}`}>{section.heading}</h2>}
        {section.body && <p>{section.body}</p>}
        {section.items?.length ? (
          <div class="feature-grid">
            {section.items.map((item) => <article class="feature-card"><h3>{item.title}</h3>{item.body && <p>{item.body}</p>}</article>)}
          </div>
        ) : null}
      </div>
    )}
    {section.type === 'cta' && (
      <div class="section-inner cta-inner">
        <div>
          {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
          {section.heading && <h2 id={`section-heading-${index}`}>{section.heading}</h2>}
          {section.body && <p>{section.body}</p>}
        </div>
        {section.button_label && isSafeHref(section.button_url) && <a class="button" href={section.button_url}>{section.button_label} <span aria-hidden="true">↗</span></a>}
      </div>
    )}
    {section.type === 'faq' && (
      <div class="section-inner">
        {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
        {section.heading && <h2 id={`section-heading-${index}`}>{section.heading}</h2>}
        {section.body && <p>{section.body}</p>}
        {section.items?.length ? (
          <div class="faq-list">
            {section.items.map((item) => <details><summary>{item.title}</summary>{item.body && <p>{item.body}</p>}</details>)}
          </div>
        ) : null}
      </div>
    )}
  </section>
))}
