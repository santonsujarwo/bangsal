---
import site from '../data/site.json';
import navigation from '../data/navigation.json';

type NavigationItem = { label: string; url: string; external?: boolean };
const navItems = navigation.items as NavigationItem[];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (url: string) => {
  if (/^https?:\/\//i.test(url)) return false;
  const target = url.replace(/\/$/, '') || '/';
  return target === '/' ? currentPath === '/' : currentPath === target || currentPath.startsWith(`${target}/`);
};
const navLink = (item: NavigationItem) => (
  <a
    href={item.url}
    target={item.external ? '_blank' : undefined}
    rel={item.external ? 'noopener noreferrer' : undefined}
    aria-current={isCurrent(item.url) ? 'page' : undefined}
  >{item.label}</a>
);
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label={`${site.site_name} home`}>
      {site.logo ? <img src={site.logo} alt={site.site_name} /> : <span>{site.site_name}</span>}
    </a>
    <nav class="site-nav site-nav-desktop" aria-label="Main navigation">
      {navItems.map((item) => navLink(item))}
    </nav>
    <a class="site-header-cta" href="/contact/">Let's Talk <span aria-hidden="true">↗</span></a>
    <details class="site-nav-mobile">
      <summary aria-label="Open navigation menu">
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        <span>Menu</span>
      </summary>
      <nav class="site-nav" aria-label="Mobile navigation">
        {navItems.map((item) => navLink(item))}
        <a href="/contact/">Let's Talk ↗</a>
      </nav>
    </details>
  </div>
</header>
